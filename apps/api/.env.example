# We Love Memory API - Environment Variables
# Copie para .env e preencha os valores

# App
DEBUG=true
SECRET_KEY=dev-secret-change-in-production

# Database (SQLite para dev, PostgreSQL para prod)
DATABASE_URL=sqlite+aiosqlite:///./wlm.db
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/wlm

# Supabase (opcional - para storage e auth em produção)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_BUCKET=wlm-assets

# Redis (para queue de jobs IA)
REDIS_URL=redis://localhost:6379/0

# IA Externa (placeholder para Nano Banana 2.1)
AI_API_URL=https://api.example.com/v1
AI_API_KEY=your-api-key